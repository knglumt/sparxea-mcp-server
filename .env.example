# Copy this file to `.env` and fill it in.
#
# This server connects via ODBC (one driver, pyodbc) to whatever DBMS
# your Sparx EA repository actually uses - the same approach EA itself
# documents for server-based repositories that aren't using its "Native
# Connection". You need the matching ODBC driver installed on this
# machine first; see README.md's Requirements section for exact install
# commands per DBMS (SQL Server, MySQL/MariaDB, PostgreSQL, Oracle,
# Firebird).

# ============================================================
# Required
# ============================================================
# Exact name of an installed ODBC driver, as shown by `odbcinst -q -d`.
# Common values:
#   ODBC Driver 18 for SQL Server   (Microsoft's driver)
#   FreeTDS                          (open-source SQL Server alternative)
#   MariaDB Unicode                  (MySQL and MariaDB)
#   PostgreSQL Unicode
#   Oracle 21 ODBC driver             (name varies by install)
#   Firebird/InterBase(r) driver
EA_DB_DRIVER=ODBC Driver 18 for SQL Server

EA_DB_SERVER=db-host.example.com
EA_DB_NAME=EA_Repository
EA_DB_USER=ea_reader
EA_DB_PASSWORD=change-me

# ============================================================
# Optional
# ============================================================
# Informational + enables two small vendor-specific behaviours (see
# config.py/db.py): sqlserver adds Encrypt/TrustServerCertificate keys,
# and mysql/mariadb get ANSI_QUOTES enabled automatically after connecting.
# One of: sqlserver, mysql, mariadb, postgresql, oracle, firebird, other
EA_DB_BACKEND=sqlserver

# Defaults to each DBMS's standard port if omitted (1433/3306/5432/1521/3050).
EA_DB_PORT=

# --- SQL Server only ---
EA_DB_ENCRYPT=true
EA_DB_TRUST_SERVER_CERT=true
# Windows/AD auth instead of SQL auth - uncommon on Linux, leave false
# unless unixODBC is set up for Kerberos.
EA_DB_TRUSTED_CONNECTION=false

# Raw passthrough appended verbatim to the ODBC connection string, for any
# driver-specific key this config doesn't already handle, e.g.:
#   EA_DB_EXTRA_PARAMS=SSLMode=require
EA_DB_EXTRA_PARAMS=

# --- Tuning ---
EA_DB_CONNECT_TIMEOUT=10
# Hard cap applied to every list-returning tool, regardless of the
# `limit` argument the MCP client asks for.
EA_MCP_ROW_LIMIT=200
EA_MCP_LOG_LEVEL=INFO

# ============================================================
# HTTP transport (only needed if hosting this as a remote MCP server -
# see README's "Hosting on a server" section. Leave MCP_TRANSPORT unset
# for local STDIO use with Claude Desktop/Code.)
# ============================================================
# stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp
# Shared secret clients must send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
# Leave unset ONLY if the port is unreachable except through a trusted
# boundary that adds its own auth - never leave it unset on a public port.
MCP_AUTH_TOKEN=
# Required if you put a reverse proxy in front (see deploy/Caddyfile or
# deploy/nginx-sparxea-mcp.conf) - the public domain clients connect to.
# Without this, the built-in DNS-rebinding protection rejects every
# request forwarded through the proxy with 421 Invalid Host header.
MCP_PUBLIC_HOSTNAME=
